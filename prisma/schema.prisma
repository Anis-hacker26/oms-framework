generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrderStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  ON_HOLD
  COMPLETED
  CANCELLED
  FAILED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CARD
  UPI
  BANK_TRANSFER
  NET_BANKING
  WALLET
  CASH
  OTHER
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  ARCHIVED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  SYSTEM
}

model Tenant {
  // =====================================================
  // Primary Key
  // =====================================================

  id String @id @default(uuid())

  // =====================================================
  // Basic Information
  // =====================================================

  name         String
  contactEmail String @unique
  slug         String @unique

  // =====================================================
  // Status
  // =====================================================

  isActive    Boolean @default(true)
  isSuspended Boolean @default(false)

  suspendedAt     DateTime?
  suspendedReason String?

  // =====================================================
  // Additional Data
  // =====================================================

  metadata Json?

  // =====================================================
  // Soft Delete
  // =====================================================

  deletedAt DateTime?

  // =====================================================
  // Audit Fields
  // =====================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // =====================================================
  // Relationships
  // =====================================================

  users         User[]
  roles         Role[]
  orders        Order[]
  payments      Payment[]
  notifications Notification[]

  @@index([name])
  @@index([contactEmail])
}

model User {
  // =====================================================
  // Primary Key
  // =====================================================

  id String @id @default(uuid())

  // =====================================================
  // Tenant Relationship
  // =====================================================

  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id])

  // =====================================================
  // Authentication
  // =====================================================

  email String @unique

  passwordHash String

  // =====================================================
  // Profile
  // =====================================================

  firstName String

  lastName String?

  // =====================================================
  // Status
  // =====================================================

  status UserStatus @default(ACTIVE)

  // =====================================================
  // Soft Delete
  // =====================================================

  deletedAt DateTime?

  // =====================================================
  // Audit Fields
  // =====================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // =====================================================
  // Relationships
  // =====================================================

  refreshTokens UserRefreshToken[]

  roles UserRole[]

  notifications Notification[]

  createdOrders Order[] @relation("CreatedOrders")

  updatedOrders Order[] @relation("UpdatedOrders")

  createdPayments Payment[] @relation("CreatedPayments")

  updatedPayments Payment[] @relation("UpdatedPayments")

  createdNotifications Notification[] @relation("NotificationCreatedBy")
  updatedNotifications Notification[] @relation("NotificationUpdatedBy")

  // =====================================================
  // Indexes
  // =====================================================

  @@index([tenantId])
  @@index([email])
}

model UserRefreshToken {
  // =====================================================
  // Primary Key
  // =====================================================

  id String @id @default(uuid())

  // =====================================================
  // User Relationship
  // =====================================================

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // =====================================================
  // Token
  // =====================================================

  tokenHash String

  // =====================================================
  // Session Information
  // =====================================================

  expiresAt DateTime

  revokedAt DateTime?

  // =====================================================
  // Audit Fields
  // =====================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // =====================================================
  // Indexes
  // =====================================================

  @@index([userId])
  @@index([expiresAt])
}

model Permission {
  // =====================================================
  // Primary Key
  // =====================================================

  id String @id @default(uuid())

  // =====================================================
  // Permission Information
  // =====================================================

  name String @unique @db.VarChar(100)

  description String?

  // =====================================================
  // Audit Fields
  // =====================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // =====================================================
  // Relationships
  // =====================================================

  rolePermissions RolePermission[]

  // =====================================================
  // Indexes
  // =====================================================
}

model Role {
  // =====================================================
  // Primary Key
  // =====================================================

  id String @id @default(uuid())

  // =====================================================
  // Tenant Relationship
  // =====================================================

  tenantId String?

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  // =====================================================
  // Role Information
  // =====================================================

  name String @db.VarChar(100)

  description String? @db.VarChar(255)

  // =====================================================
  // System Role
  // =====================================================

  isSystem Boolean @default(false)

  // =====================================================
  // Soft Delete
  // =====================================================

  deletedAt DateTime?

  // =====================================================
  // Audit Fields
  // =====================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // =====================================================
  // Relationships
  // =====================================================

  users UserRole[]

  permissions RolePermission[]

  // =====================================================
  // Constraints
  // =====================================================

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([deletedAt])
  @@index([name])
}

model UserRole {
  // =====================================================
  // Primary Key
  // =====================================================

  id String @id @default(uuid())

  // =====================================================
  // Relationships
  // =====================================================

  userId String

  roleId String

  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  // =====================================================
  // Audit Fields
  // =====================================================

  assignedAt DateTime @default(now())

  // =====================================================
  // Constraints
  // =====================================================

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  // =====================================================
  // Primary Key
  // =====================================================

  id String @id @default(uuid())

  // =====================================================
  // Relationships
  // =====================================================

  roleId String

  permissionId String

  assignedBy String?

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  // =====================================================
  // Audit Fields
  // =====================================================

  assignedAt DateTime @default(now())

  // =====================================================
  // Constraints
  // =====================================================

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Order {
  // =====================================================
  // Primary Key
  // =====================================================

  id String @id @default(uuid())

  // =====================================================
  // Tenant Relationship
  // =====================================================

  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id])

  // =====================================================
  // Order Information
  // =====================================================

  orderNumber String

  title String

  description String?

  status OrderStatus @default(DRAFT)

  metadata Json?

  // =====================================================
  // Audit Relationships
  // =====================================================

  createdById String

  createdBy User @relation("CreatedOrders", fields: [createdById], references: [id])

  updatedById String?

  updatedBy User? @relation("UpdatedOrders", fields: [updatedById], references: [id])

  // =====================================================
  // Payment Relationships
  // =====================================================

  payments Payment[]

  // =====================================================
  // Optimistic Locking
  // =====================================================

  version Int @default(1)

  // =====================================================
  // Soft Delete
  // =====================================================

  deletedAt DateTime?

  // =====================================================
  // Audit Fields
  // =====================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // =====================================================
  // Constraints
  // =====================================================

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([status])
  @@index([createdById])
  @@index([deletedAt])
  @@index([createdAt])
}

model Payment {
  // =====================================================
  // Primary Key
  // =====================================================

  id String @id @default(uuid())

  // =====================================================
  // Tenant Relationship
  // =====================================================

  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id])

  // =====================================================
  // Order Relationship
  // =====================================================

  orderId String

  order Order @relation(fields: [orderId], references: [id])

  // =====================================================
  // Payment Information
  // =====================================================

  paymentReference String @db.VarChar(100)

  provider String @db.VarChar(100)

  method PaymentMethod

  currency String @db.VarChar(10)

  amount Decimal @db.Decimal(18, 2)

  status PaymentStatus @default(PENDING)

  gatewayTransactionId String? @db.VarChar(255)

  failureReason String? @db.VarChar(500)

  metadata Json?

  // =====================================================
  // Audit Relationships
  // =====================================================

  createdById String

  createdBy User @relation("CreatedPayments", fields: [createdById], references: [id])

  updatedById String?

  updatedBy User? @relation("UpdatedPayments", fields: [updatedById], references: [id])

  // =====================================================
  // Optimistic Locking
  // =====================================================

  version Int @default(1)

  // =====================================================
  // Soft Delete
  // =====================================================

  deletedAt DateTime?

  // =====================================================
  // Audit Fields
  // =====================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // =====================================================
  // Constraints
  // =====================================================

  @@unique([tenantId, paymentReference])
  @@index([tenantId])
  @@index([orderId])
  @@index([status])
  @@index([createdById])
  @@index([deletedAt])
  @@index([createdAt])
}

model Notification {
  id String @id @default(uuid())

  // Multi-tenancy
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // Recipient
  recipientId String
  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  // Notification Content
  title   String @db.VarChar(255)
  message String

  // Notification Metadata
  type    NotificationType
  channel NotificationChannel
  status  NotificationStatus  @default(PENDING)

  metadata Json?

  // Read / Archive
  readAt     DateTime?
  archivedAt DateTime?

  // Audit Fields
  createdById String?
  createdBy   User?   @relation("NotificationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  updatedById String?
  updatedBy   User?   @relation("NotificationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optimistic Locking
  version Int @default(1)

  @@index([tenantId])
  @@index([recipientId])
  @@index([status])
  @@index([channel])
  @@index([type])
  @@index([createdAt])
}
